{
	"name": "captgrab",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"zip": "pnpm build && mkdir -p release && cd dist && zip -FS -r ../release/captgrab-$npm_package_version.zip . -x '*.DS_Store'",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "vite build && playwright test"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^3.0.0",
		"@playwright/test": "^1.64.1",
		"@types/chrome": "^0.3.7",
		"@types/node": "^26.6.6",
		"jsdom": "^30.1.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.5.1",
	"license": "MIT"
}
